INPUT_MODE=dshow

# Exact names reported by: ffmpeg -list_devices true -f dshow -i dummy
VIDEO_DEVICE=Your Camera Name
AUDIO_DEVICE=Your Microphone Name

APP_PASSWORD=replace-with-a-strong-password
# Generate a random value of at least 32 characters. Changing it signs out browsers.
SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_SECURE=0
AUTH_SESSION_HOURS=12

# Presets shown on the Live page. The default must be one of these values.
REPLAY_PRESETS_SECONDS=30,60,180
DEFAULT_REPLAY_SECONDS=180
MAX_BUFFER_MINUTES=5
# Two-second closed-GOP MPEG-TS segments provide a short, recoverable live tail.
CHUNK_SECONDS=2

VIDEO_RESOLUTION=1280x720
FPS=30
CAMERA_ROTATION_DEGREES=0
# Combined DirectShow capture normally needs no manual offset.
# Negative values advance audio; positive values delay it.
AUDIO_SYNC_OFFSET_MS=0
DSHOW_RTBUFSIZE=256M

LIVE_FPS=5
LIVE_WIDTH=640
LIVE_JPEG_QUALITY=10

# A silent microphone still emits samples and does not trigger a reset.
AUDIO_STARTUP_GRACE_SECONDS=10
AUDIO_STALL_SECONDS=3
VIDEO_STALL_SECONDS=10
RESTART_MAX_BACKOFF_SECONDS=30

# Optional override. By default the app uses ./ffmpeg/ffmpeg.exe.
# FFMPEG_PATH=C:\path\to\ffmpeg.exe

# Optional copy of only the new MP4 and its initial JSON metadata sidecar.
# REPLAY_BACKUP_DIR=\\server\share\SigitCamReplays
